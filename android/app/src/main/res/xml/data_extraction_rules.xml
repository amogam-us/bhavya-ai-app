<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is backed up or transferred: the app only stores the hub address and a glasses setting. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
