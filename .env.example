# Meta Model API key (https://dev.meta.ai). Required.
MODEL_API_KEY=

# Optional overrides
# HUB_PORT=8787
# HUB_HOST=0.0.0.0
# MUSE_BASE_URL=https://api.meta.ai/v1
# DATA_DIR=./data
# LOG_LEVEL=info

# Home simulator
# SIMULATOR=show          # show | hide (hide only removes its link from the home page)
# SIMULATOR_VIEW=both     # both (3D + a Simple view button) | 3d | simple

# Finding routines with the glasses camera (off hides the parent setting)
# GLASSES_SUGGESTIONS=on  # on | off
# Minutes the glasses stop looking around after seeing a private place (1 to 60)
# PRIVATE_PAUSE_MINUTES=10

# Testing: show in the child app what Muse saw in each camera frame
# CAMERA_DEBUG=off        # on | off
