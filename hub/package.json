{
  "name": "@bhavya/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bhavya AI home hub: mission engine, privacy gate, Muse gateway and device bridge.",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=../.env --import tsx src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@bhavya/shared": "*",
    "@fastify/static": "^8.0.3",
    "@fastify/websocket": "^11.0.1",
